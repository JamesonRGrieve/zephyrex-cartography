{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "scripts/*.mjs",
        "src/**/*.test.ts",
        "src/**/*.stories.ts"
    ],
    "project": [
        "src/**/*.ts"
    ],
    "vitest": {
        "config": "vitest.config.ts"
    },
    "playwright": {
        "config": "playwright.*.config.ts",
        "entry": "tests/**/*.spec.ts"
    }
}
