{
    "id": "zephyrex-cartography",
    "title": "Zephyrex Cartography",
    "description": "Standalone scene authoring for Foundry VTT: paint terrain, draw roads and rivers, build structures, and place structure-aware stamps (walls, lights, doors, levels, interiors), all as native Foundry documents.",
    "version": "0.2.0",
    "authors": [
        {
            "name": "Jameson Grieve"
        }
    ],
    "compatibility": {
        "minimum": "14",
        "verified": "14"
    },
    "esmodules": [
        "dist/zephyrex-cartography.js"
    ],
    "styles": [
        "dist/zephyrex-cartography.css"
    ],
    "languages": [
        {
            "lang": "en",
            "name": "English",
            "path": "dist/lang/en.json"
        }
    ],
    "relationships": {
        "recommends": [
            {
                "id": "item-piles",
                "type": "module",
                "reason": "Container stamps become lootable Item Piles containers."
            },
            {
                "id": "zephyrex-cartography-assets",
                "type": "module",
                "reason": "Stamp art and terrain texture sets."
            }
        ]
    },
    "license": "AGPL-3.0-or-later",
    "url": "https://github.com/JamesonRGrieve/zephyrex-cartography",
    "flags": {}
}
