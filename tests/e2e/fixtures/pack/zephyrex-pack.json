{
    "$schema": "https://raw.githubusercontent.com/JamesonRGrieve/zephyrex-cartography/main/schema/stamp-pack.v1.schema.json",
    "schemaVersion": 1,
    "id": "zc-e2e-pack",
    "name": "Cartography E2E Stamp Pack",
    "license": "AGPL-3.0-or-later",
    "referenceGridSize": 100,
    "stamps": [
        {
            "id": "lamp",
            "name": "Lamp",
            "category": "Lighting",
            "scale": "interior",
            "perspective": "top-down",
            "light": {
                "dim": 4,
                "bright": 2,
                "color": "#ffcc88"
            },
            "variants": [
                {
                    "state": "lit",
                    "image": "stamps/lamp-lit.svg",
                    "width": 100,
                    "height": 100
                },
                {
                    "state": "unlit",
                    "image": "stamps/lamp-unlit.svg",
                    "width": 100,
                    "height": 100,
                    "light": null
                }
            ]
        },
        {
            "id": "door",
            "name": "Door",
            "category": "Doors",
            "scale": "interior",
            "perspective": "top-down",
            "door": {
                "type": "door"
            },
            "variants": [
                {
                    "state": "closed",
                    "image": "stamps/door-closed.svg",
                    "width": 100,
                    "height": 20,
                    "doorState": "closed"
                },
                {
                    "state": "open",
                    "image": "stamps/door-open.svg",
                    "width": 100,
                    "height": 20,
                    "doorState": "open"
                }
            ]
        },
        {
            "id": "crate",
            "name": "Crate",
            "category": "Storage",
            "scale": "interior",
            "perspective": "top-down",
            "occlusion": {
                "shape": "bounds"
            },
            "physical": {
                "height": 1,
                "cover": 0.5,
                "blocksMovement": true
            },
            "variants": [
                {
                    "state": "shut",
                    "image": "stamps/crate.svg",
                    "width": 100,
                    "height": 100
                }
            ]
        },
        {
            "id": "hab",
            "name": "Hab",
            "category": "Structures",
            "scale": "city",
            "perspective": "top-down",
            "enterable": true,
            "variants": [
                {
                    "state": "intact",
                    "image": "stamps/hab.svg",
                    "width": 200,
                    "height": 200
                }
            ]
        },
        {
            "id": "stairs",
            "name": "Stairs",
            "category": "Access",
            "scale": "interior",
            "perspective": "top-down",
            "transition": {
                "kind": "stairs",
                "direction": "both"
            },
            "variants": [
                {
                    "state": "stone",
                    "image": "stamps/stairs.svg",
                    "width": 100,
                    "height": 100
                }
            ]
        }
    ],
    "textureSets": []
}
